# ============================================================
# Market Intelligence Engine - Environment Configuration
# ============================================================

# Environment
APP_ENV=development
DEBUG=True

# Data Lake Storage Paths
DATA_LAKE_DIR=data
BRONZE_DIR=data/bronze
SILVER_DIR=data/silver
GOLD_DIR=data/gold
DUCKDB_PATH=data/warehouse.duckdb

# Market Data (Binance)
BINANCE_BASE_URL=https://api.binance.com
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h

# Macro Sentiment (Alternative.me)
FEAR_GREED_API_URL=https://api.alternative.me/fng/

# Social Data (Reddit API - Optional, has public fallback)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MarketIntelligenceEngine/0.1.0

# News API (Optional)
NEWS_API_KEY=

# NLP Model Configuration
FINBERT_MODEL_NAME=ProsusAI/finbert
NLP_BATCH_SIZE=64
USE_MOCK_NLP=false
