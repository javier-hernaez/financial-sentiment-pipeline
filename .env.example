# ============================================================
# Market Intelligence Engine - Environment Configuration
# The API and the local Next.js server both read this file.
# ============================================================

# Environment. With "production" the API refuses to start on the default secret below.
APP_ENV=development

# Data lake and warehouse. Relative paths start at the repository root.
BRONZE_DIR=data/bronze
DUCKDB_PATH=data/warehouse.duckdb

# Market Data (Binance)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FALLBACK_URL=https://data-api.binance.vision
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h

# Security & Access Control
# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=dev-insecure-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# NLP Model Configuration
FINBERT_MODEL_NAME=ProsusAI/finbert
NLP_BATCH_SIZE=64
USE_MOCK_NLP=false
